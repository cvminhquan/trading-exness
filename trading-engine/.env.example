# =============================================================================
# Exness Trading Bot — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to git.
# =============================================================================

# --- SAFETY ---
# Supported modes: dry_run | demo | live
# dry_run  = log actions only, no broker orders (default, safest)
# demo     = connect to demo account and submit orders
# live     = real trading — requires ALLOW_LIVE_TRADING=true
TRADING_MODE=dry_run
DRY_RUN=true
ALLOW_LIVE_TRADING=false

# Dashboard operator close (opt-in). Close-only; does not enable bot entry.
# DEMO confirm: CLOSE / CLOSE-ALL
# LIVE confirm: LIVE-CLOSE / LIVE-CLOSE-ALL (+ ALLOW_LIVE_TRADING + LIVE_KILL_SWITCH=false)
DASHBOARD_ALLOW_CLOSE_POSITION=false

# Phase 17.3 — autonomous DEMO loop (DEFAULT OFF). DEMO ONLY. Never real-money autonomy.
# Requires: TRADING_ENV=demo, LIVE_DEMO_APPROVAL=true, LIVE_KILL_SWITCH=false,
# DEMO_ACCOUNT_ALLOWLIST=<login>, verified demo account.
# Start explicitly: python -m exness_bot.execution.auto_demo run|once|status
AUTO_DEMO_EXECUTION_ENABLED=false

# --- MT5 Connection ---
MT5_ENABLED=false
# MT5_LOGIN=
# Password values with special characters MUST be double-quoted, e.g.:
# MT5_PASSWORD="your-password-here"
# Unquoted passwords containing #, spaces, or quotes cause:
#   python-dotenv could not parse statement starting at line N
# Never commit real credentials. Never log MT5_PASSWORD.
# MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trial
# MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
MT5_TIMEOUT=30
# MT5_SYMBOL=XAUUSDm

# --- Runtime data source (Phase 10.6) ---
# mock | backtest | mt5
DATA_SOURCE=mock
SYMBOL=XAUUSD
TIMEFRAME=M15
# Watchlist giá realtime trên Dashboard (canonical names; broker suffix như m được resolve nội bộ)
WATCHLIST_SYMBOLS=XAUUSD,EURUSD,GBPUSD,USDJPY,XAGUSD,BTCUSD,ETHUSD

# --- Dual MT5 accounts (read-only switcher) ---
# Demo defaults to MT5_LOGIN / MT5_PASSWORD / MT5_SERVER when these are empty.
# MT5_DEMO_LOGIN=
# MT5_DEMO_PASSWORD=
# MT5_DEMO_SERVER=Exness-MT5Trial17
# Live credentials are required before the Dashboard can switch to the real account.
# Switching does NOT enable live orders (ALLOW_LIVE_TRADING stays false).
# MT5_LIVE_LOGIN=
# MT5_LIVE_PASSWORD=
# MT5_LIVE_SERVER=Exness-MT5Real
MT5_ACTIVE_ACCOUNT=demo

# --- Risk Management ---
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2.0
MAX_DRAWDOWN_PCT=5.0
MAX_OPEN_POSITIONS=1
MAX_POSITION_LOTS=1.0
MAX_SPREAD_POINTS=260
MARGIN_SAFETY_FACTOR=1.05

# --- Strategy Parameters (proposed defaults) ---
ATR_SL_MULTIPLIER=1.5
REWARD_RISK_RATIO=2.0
RSI_LONG_MIN=50
RSI_LONG_MAX=70
RSI_SHORT_MIN=30
RSI_SHORT_MAX=50

# --- Phase 16.1 market structure / S-R (analysis only) ---
SWING_LEFT_BARS=2
SWING_RIGHT_BARS=2
SR_CLUSTER_ATR_MULTIPLIER=0.25
SR_NEAR_ATR_THRESHOLD=0.5
SR_CAUTION_ATR_THRESHOLD=1.0

# --- Phase 16.2 multi-timeframe analysis (analysis only) ---
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
VOLUME_AVG_PERIOD=20
VOLUME_HIGH_RATIO=1.5
VOLUME_LOW_RATIO=0.7
MTF_WEIGHT_M15=0.20
MTF_WEIGHT_H1=0.30
MTF_WEIGHT_H4=0.30
MTF_WEIGHT_D1=0.20
TP1_ALLOCATION_PCT=30
TP2_ALLOCATION_PCT=40
TP3_ALLOCATION_PCT=30

# --- Phase 16.3 analysis → execution contract (no broker orders) ---
SETUP_MAX_CANDLES=8
ACCOUNT_SNAPSHOT_MAX_AGE_SECONDS=10

# --- Database ---
DATABASE_URL=sqlite:///exness_bot.db
# DATABASE_URL=postgresql://exness_bot:exness_bot@localhost:5432/exness_bot

# --- Read-only HTTP API (Phase 10.5) ---
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Quote older than this is STALE (LIVE / STALE / UNAVAILABLE)
LIVE_DATA_STALE_SECONDS=10

# --- Live Candle Engine (Phase 11.1) ---
# Closed M15 candles only. No strategy, no orders.
CANDLE_ENGINE_ENABLED=false
CANDLE_TIMEFRAME=M15
CANDLE_POLL_INTERVAL_SECONDS=3
CANDLE_SYMBOL=XAUUSD

# --- Signal Engine (Phase 11.2) ---
# Research signals from closed candles. No orders (paper or live).
# When true, API also runs the candle poll in the same thread (do not also enable CANDLE_ENGINE_ENABLED).
SIGNAL_ENGINE_ENABLED=false

# --- Paper Execution (Phase 11.3+) ---
# Virtual fills only. Never send orders to Exness.
# Unsupported values (including live) fail closed — there is no live fallback.
EXECUTION_MODE=paper
PAPER_EXECUTION_ENABLED=false

# --- Legacy `exness-bot run` (DEPRECATED) ---
# OrderManager → MT5Adapter stack. Blocked unless explicitly enabled.
# Phase 11 paper/signals/candles never use this path.
ALLOW_LEGACY_RUN=false

# --- Future live enablement (Phase 12.2/12.3 — boundary only, not autonomous) ---
# Multi-gate policy in config/live_enablement.py.
# LIVE_KILL_SWITCH=true blocks live. false does NOT enable live alone.
# EXECUTION_MODE=live is parseable for preflight but paper path refuses to run it.
# MT5Executor exists (Phase 12.3) but is NOT wired into autonomous runtime.
LIVE_EXECUTION_ENABLED=false
LIVE_KILL_SWITCH=true
TRADING_ENV=research
LIVE_ACCOUNT_ALLOWLIST=
LIVE_SERVER_ALLOWLIST=
# Canonical → broker symbol map for MT5Executor.
# LIVE_SYMBOL_MAP=XAUUSD:XAUUSDm
MT5_MAGIC=120300
MT5_ORDER_DEVIATION=20

# --- Phase 12.4 / 17.2 controlled DEMO one-shot (NOT autonomous) ---
# TRADING_ENV must be demo. Never live/production/real for this path.
# LIVE_DEMO_APPROVAL is one-shot; consume via CLI --confirm DEMO-EXECUTE.
# LIVE_KILL_SWITCH default true blocks; set false only for the approved smoke.
# Phase 17.2: exness-bot candidate-demo-execution-smoke (preview default).
# AI/Cursor must NEVER run --execute --confirm DEMO-EXECUTE.
LIVE_DEMO_APPROVAL=false
DEMO_ACCOUNT_ALLOWLIST=
DEMO_SERVER_ALLOWLIST=

# --- Phase 16.3.2 / 16.3.7 External Intelligence (read-only) ---
# Default OFF — core dashboard/API unchanged when disabled.
# Free-sources-first: BLS / Fed / allowlisted RSS (FRED optional).
# Google Search Grounding is OPTIONAL enrichment only (default OFF).
EXTERNAL_INTELLIGENCE_ENABLED=false
EXTERNAL_INTELLIGENCE_PROVIDER=free_sources
FREE_EXTERNAL_SOURCES_ENABLED=true
BLS_ENABLED=true
BLS_API_KEY=
FRED_ENABLED=false
FRED_API_KEY=
FEDERAL_RESERVE_ENABLED=true
EXTERNAL_RSS_ENABLED=true
GOOGLE_GROUNDING_ENABLED=false
# GEMINI_API_KEY=   # only if using gemini_google provider or synthesis/chat
EXTERNAL_INTELLIGENCE_MODEL=gemini-2.5-flash
EXTERNAL_INTELLIGENCE_CACHE_TTL_SECONDS=600

# --- Phase 16.3.3 AI Market Synthesis (read-only; no web search) ---
# Default OFF — deterministic synthesis still works without AI.
AI_MARKET_SYNTHESIS_ENABLED=false
AI_MARKET_SYNTHESIS_PROVIDER=gemini
# Reuses GEMINI_API_KEY above.
AI_MARKET_SYNTHESIS_MODEL=gemini-2.5-flash
AI_MARKET_SYNTHESIS_CACHE_TTL_SECONDS=600
AI_MARKET_SYNTHESIS_TIMEOUT_SECONDS=30

# --- Phase 16.3.5 AI Market Analyst Chat (read-only; no web search; no execution) ---
# Default OFF — deterministic fallback still answers common intents.
AI_MARKET_ANALYST_CHAT_ENABLED=false
AI_MARKET_ANALYST_CHAT_PROVIDER=gemini
# Reuses GEMINI_API_KEY above.
AI_MARKET_ANALYST_CHAT_MODEL=gemini-2.5-flash
AI_MARKET_ANALYST_CHAT_TIMEOUT_SECONDS=30
AI_MARKET_ANALYST_CHAT_MAX_HISTORY_MESSAGES=12
AI_MARKET_ANALYST_CHAT_MAX_MESSAGE_LENGTH=3000
# Max chat requests per symbol per 60s window.
AI_MARKET_ANALYST_CHAT_RATE_LIMIT=20
